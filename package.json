{
  "name": "wonderland-plugin-template-plugin",
  "author": "YueFChen",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11.22.0 <12"
  },
  "scripts": {
    "build": "node scripts/build-plugin.mjs",
    "debug": "node scripts/debug-plugin.mjs",
    "debug:ui": "node scripts/debug-plugin.mjs --experimental-ui",
    "package:plugin": "node scripts/build-plugin.mjs --release --archive",
    "typecheck": "pnpm --dir ui run typecheck",
    "validate": "node scripts/validate-template.mjs",
    "package:release": "node scripts/build-plugin.mjs --release --archive --signed"
  }
}
