{
  "manifestVersion": 3,
  "id": "template_plugin",
  "name": "Wonderland Plugin Template",
  "version": "0.1.2",
  "description": "Starter plugin template for the Wonderland dynamic plugin host.",
  "icon": "puzzle",
  "hostCompatibility": {
    "minCoreVersion": "0.2.0",
    "maxCoreVersionExclusive": "0.3.0",
    "protocol": {
      "minVersion": "1.0.0",
      "maxVersionExclusive": "2.0.0"
    }
  },
  "platform": {
    "os": "windows",
    "architecture": "x86_64",
    "abi": "msvc"
  },
  "ui": {
    "entry": "ui/index.html",
    "bridgeCompatibility": {
      "minVersion": "1.0.0",
      "maxVersionExclusive": "2.0.0"
    },
    "integrations": [
      "theme.followHost",
      "workspace.sidebar"
    ],
    "contributions": [
      {
        "id": "main",
        "kind": "activity",
        "title": "Wonderland Plugin Template",
        "icon": "puzzle",
        "defaultOrder": 500
      },
      {
        "id": "details",
        "kind": "view",
        "title": "Wonderland Plugin Template Details",
        "icon": "images",
        "defaultOrder": 510,
        "location": "workspace.sidebar"
      }
    ]
  },
  "backend": {
    "entry": "backend/wonderland-template-plugin.exe",
    "transport": "stdio-ndjson-v1",
    "supportsServiceContext": true
  },
  "contract": "contract.json",
  "author": "YueFChen"
}
